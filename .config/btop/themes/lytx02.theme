# Generated by lytx02 theme.py from ~/.config/lytx02/templates/btop.theme. Do not edit.
# Colors come from the shared semantic palette (presets or Matugen).

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="#0d0e13"

# Main text color
theme[main_fg]="#e3e2e9"

# Title color for boxes
theme[title]="#e3e2e9"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b2c5ff"

# Background and foreground color for selected item in processes box
theme[selected_bg]="#292a2f"
theme[selected_fg]="#e3e2e9"

# Color of inactive/disabled text
theme[inactive_fg]="#45464f"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c0c6dd"

# Box outline and divider line colors
theme[cpu_box]="#45464f"
theme[mem_box]="#45464f"
theme[net_box]="#45464f"
theme[proc_box]="#45464f"
theme[div_line]="#45464f"

# Temperature graph colors
theme[temp_start]="#8f909a"
theme[temp_mid]="#ffb4ab"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#8f909a"
theme[cpu_mid]="#c5c6d0"
theme[cpu_end]="#b2c5ff"

# Mem/Disk free meter
theme[free_start]="#8f909a"
theme[free_mid]="#8f909a"
theme[free_end]="#e1bbdc"

# Mem/Disk cached meter
theme[cached_start]="#8f909a"
theme[cached_mid]="#8f909a"
theme[cached_end]="#c0c6dd"

# Mem/Disk available meter
theme[available_start]="#8f909a"
theme[available_mid]="#8f909a"
theme[available_end]="#c5c6d0"

# Mem/Disk used meter
theme[used_start]="#8f909a"
theme[used_mid]="#c5c6d0"
theme[used_end]="#b2c5ff"

# Download graph colors
theme[download_start]="#8f909a"
theme[download_mid]="#8f909a"
theme[download_end]="#c0c6dd"

# Upload graph colors
theme[upload_start]="#8f909a"
theme[upload_mid]="#8f909a"
theme[upload_end]="#b2c5ff"
